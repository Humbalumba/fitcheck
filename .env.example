# FitCheck configuration. Copy to .env (never commit it) or run: python3 deploy/init_env.py --public-url https://...
# Secrets left empty here are generated by deploy/init_env.py.

# Public site URL (what users open). AUTH_URL / APP_URL / ALLOWED_ORIGINS normally equal it.
PUBLIC_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
AUTH_TRUST_HOST=true

# Postgres
POSTGRES_USER=fitcheck
POSTGRES_PASSWORD=
POSTGRES_DB=fitcheck

# Photo storage (MinIO locally; any S3-compatible bucket in production -- see docs/DEPLOY.md)
MINIO_ROOT_USER=fitcheck
MINIO_ROOT_PASSWORD=
S3_BUCKET=fitcheck-media

# Shared secrets (frontend + backend). >= 32 random chars each.
AUTH_SECRET=
BACKEND_JWT_SECRET=
INTERNAL_API_SECRET=
MEDIA_SIGNING_SECRET=

# Google sign-in (optional; the button appears when both are set)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email via Resend (optional). Until set, keep AUTH_REQUIRE_VERIFIED_EMAIL=0 so email sign-up works.
RESEND_API_KEY=
EMAIL_FROM=
AUTH_REQUIRE_VERIFIED_EMAIL=0

# Gemini keys live in backend/.env (GEMINI_API_KEY, GEMINI_IMAGE_API_KEY); compose loads that file too.
